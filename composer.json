{
  "name":"examconnect/platform","type":"project","description":"ExamConnect candidate-reported exam experience platform",
  "keywords":["laravel","exam-reviews","community"],"license":"MIT",
  "require":{"php":"^8.2","laravel/framework":"^12.0","laravel/tinker":"^2.10"},
  "require-dev":{"fakerphp/faker":"^1.23","phpunit/phpunit":"^11.5"},
  "autoload":{"psr-4":{"App\\":"app/","Database\\Factories\\":"database/factories/","Database\\Seeders\\":"database/seeders/"}},
  "autoload-dev":{"psr-4":{"Tests\\":"tests/"}},
  "scripts":{"post-autoload-dump":["Illuminate\\Foundation\\ComposerScripts::postAutoloadDump","@php artisan package:discover --ansi"],"test":"@php artisan test"},
  "config":{"optimize-autoloader":true,"preferred-install":"dist","sort-packages":true,"allow-plugins":{"php-http/discovery":true}},"minimum-stability":"stable","prefer-stable":true
}
